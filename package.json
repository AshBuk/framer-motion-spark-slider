{
  "name": "framer-motion-spark-slider",
  "version": "1.1.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Framework-agnostic React slider library with Framer Motion animations",
  "author": "Asher Buk <2asherbuk@gmail.com> (https://github.com/AshBuk)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AshBuk/framer-motion-spark-slider.git"
  },
  "bugs": {
    "url": "https://github.com/AshBuk/framer-motion-spark-slider/issues"
  },
  "homepage": "https://github.com/AshBuk/framer-motion-spark-slider#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pretest": "npm -w packages/spark-slider run build && npm run build",
    "test": "jest && NODE_TEST_PARALLEL=0 node --test tests/integration/*.spec.*",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "check-all": "npm run type-check && npm run lint && npm run format:check",
    "fix-all": "npm run lint:fix && npm run format",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "framer-motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "glob": "^10.4.5",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "typescript-eslint": "^8.70.0"
  }
}
